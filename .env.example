# Copy to .env (which is gitignored). Dev mode runs with every value blank.
# ---------------------------------------------------------------------------

# LLM for offer extraction. Pick ONE provider -- auto-detected in this order:
# DeepSeek -> OpenAI -> Anthropic (or force it with PROOFCART_LLM_PROVIDER).
DEEPSEEK_API_KEY=                        # OpenAI-compatible, cheap (api.deepseek.com)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# PROOFCART_LLM_PROVIDER=deepseek        # force a provider if you set more than one
PROOFCART_MODEL=deepseek-chat            # deepseek-chat | gpt-4o-mini | claude-sonnet-5

# Stripe -- TEST MODE ONLY. Must start with sk_test_. Never a live key.
STRIPE_SECRET_KEY=

# Slack -- bot token (xoxb-...) with scopes: channels:history, groups:history,
# chat:write. SLACK_CHANNEL_ID is the demo channel holding supplier threads.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Owner identity: the Slack user id (e.g. U0123ABCD) that is allowed to approve
# payment. Any approval from another identity is rejected.
PROOFCART_OWNER_ID=

# Notion -- integration token (ntn_... / secret_...) and a database id that has
# been shared with the integration. Holds the comparison + decision record.
NOTION_TOKEN=
NOTION_DB_ID=

# Modes
# dev  = clearly-labelled local mocks (for development only)
# live = the three real APIs (REQUIRED for the submission demo)
PROOFCART_MODE=dev
